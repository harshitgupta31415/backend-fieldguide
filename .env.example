# Optional AI tutor. Copy to .env.local, add your own keys, then restart the server.
# Course lessons, games and simulations work with every key field left empty.
# Never commit .env.local or prefix these variables with NEXT_PUBLIC_.

AI_PROVIDER_ORDER=openrouter,gemini,groq,freeai

# Each plural field accepts up to six comma-separated keys.
# Example format only: replace_with_first_key,replace_with_second_key
# Leave unused providers empty. Do not put spaces or quotes inside a key.
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
# Voice also uses these Groq keys, independently of AI_PROVIDER_ORDER.
# Transcription: whisper-large-v3-turbo. Natural speech: Orpheus English/Hannah.
# No extra voice credentials are needed. Browser voice needs no app API key.

FREEAI_API_KEYS=
FREEAI_MODEL=qwen7b

# Singular aliases are supported when the corresponding plural field is empty:
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# FREEAI_API_KEY=

# Required for Vercel, non-loopback hosts or non-loopback forwarded clients.
# Use the exact lowercase name code. Set a private value of 16–256 characters.
# Enter that same value in the access-code field; it is never filled automatically.
# Optional for direct localhost use. Setting it makes it required locally too.
code=
# Legacy fallback: TUTOR_ACCESS_CODE (used only when code is empty or absent).

# Server clamps the configured output limit to 128–1600 tokens.
AI_MAX_OUTPUT_TOKENS=1000
